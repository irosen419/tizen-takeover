# Home Hub live server settings.
# Copy this file to .env (or run ./hub token, which does it for you).
# The .env file holds your password, so it is never added to git.
# Lines starting with # are notes and are ignored.

# The password for sending changes. At least 24 characters.
# Leave it empty here and run ./hub token to create a random one.
HUB_TOKEN=

# The port the TV and hubctl talk to (the "main door").
HUB_PORT=8097

# Only these addresses may use the screen side (comma-separated), for example 192.168.1.x.
# Empty means any device on your home network.
HUB_TV_IPS=

# Web page origins allowed to talk to the server from a browser (TizenBrew uses this one).
HUB_ORIGINS=http://127.0.0.1:8081

# Optional side door for a tunnel, on 127.0.0.1 only: password-protected commands and nothing else.
# Empty means no side door. Not needed to start.
HUB_TUNNEL_PORT=

# Folder where state.json (your to-do list) is kept, relative to this folder.
HUB_DATA_DIR=./data

# The time zone the hub lives in. It decides what "today" means for the calendar,
# and the server's log uses it too. Use a name like America/Chicago or Europe/London.
HUB_TIMEZONE=America/Chicago

# Calendars: up to 9, numbered 1 to 9. See "Calendars" in README.md for where to find each link.
# Each link is a SECRET: anyone who has it can read that calendar. Keep it only in .env, never in git or a chat.
# Remove the # at the start of a line to use it.
# DETAILS=busy shows every event as just "Busy" with no place. Leave it out to show titles and places.
#
# Calendar 1: give it a short name, and paste its "Secret address in iCal format".
# CALENDAR_1_NAME=Ian
# CALENDAR_1_URL=https://calendar.google.com/calendar/ical/PASTE-YOURS-HERE/basic.ics
#
# Calendar 2: this one shows only "Busy" on the TV.
# CALENDAR_2_NAME=Work
# CALENDAR_2_URL=https://calendar.google.com/calendar/ical/PASTE-YOURS-HERE/basic.ics
# CALENDAR_2_DETAILS=busy
#
# Optional: the color a calendar has on the TV. Use red, orange, yellow, green, teal, blue, purple, pink or gray,
# or a code like #d50000. Leave it out to use the TV's own color for that number.
# CALENDAR_1_COLOR=blue
# CALENDAR_2_COLOR=red

# Spotify, for the Now Playing tile (see "Spotify" in README.md). The ID and secret are on your app's page at
# developer.spotify.com/dashboard. The secret is SECRET: keep it only in .env, never in git or a chat.
# SPOTIFY_CLIENT_ID=PASTE-CLIENT-ID
# SPOTIFY_CLIENT_SECRET=PASTE-CLIENT-SECRET
# The address Spotify sends the browser to after you agree. Only change this if HUB_PORT is not 8097; it must be
# listed under Redirect URIs in the Spotify app, and Spotify only allows http://127.0.0.1... or https://...
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8097/spotify/callback
# The visualizer asks ReccoBeats (free, no sign-up) for each song's tempo and mood. ReccoBeats sees the songs'
# Spotify IDs and the Pi's internet address, nothing else. Set to off to stop it (the Pi then guesses from Spotify genres).
# SPOTIFY_VIBE=off

# Ambience: the room's lights from the TV, through Home Assistant (see "Ambience" in README.md). Make a
# long-lived access token in Home Assistant (your profile, Security tab). It is SECRET: keep it only in .env.
# Without it the Ambience tile says "Set up lights". HA_URL is only needed if Home Assistant is not on this Pi.
# The same two lines serve every hub feature that reads Home Assistant.
# HA_TOKEN=PASTE-LONG-LIVED-TOKEN
# HA_URL=http://127.0.0.1:8123
# Optional: the plant wall's WLED controller (its address on your network; WLED has no token).
# WLED_URL=http://PASTE-WLED-ADDRESS

# How often the calendars are read again, in minutes (1 to 120).
CALENDAR_REFRESH_MINUTES=5

# Claude mailbox (optional): lets Claude in the cloud send ./hub commands through
# a Cloudflare R2 bucket. See "Claude mailbox" in README.md for the one-time setup.
# The two keys are SECRET: keep them only in .env, never in git or a chat.
# Remove the # at the start of the first three lines and paste your own values.
# HUB_MAILBOX_ENDPOINT=https://PASTE-ACCOUNT-ID.r2.cloudflarestorage.com
# HUB_MAILBOX_ACCESS_KEY_ID=PASTE-ACCESS-KEY-ID
# HUB_MAILBOX_SECRET_ACCESS_KEY=PASTE-SECRET-ACCESS-KEY
# The bucket name (this is the default) and how often to check it, in seconds (10 by default, at least 3).
# HUB_MAILBOX_BUCKET=home-hub-mailbox
# HUB_MAILBOX_POLL_SECONDS=10
