# Home Hub live server settings.
# Copy this file to .env (or run ./hub token, which does it for you).
# The .env file holds your password, so it is never added to git.
# Lines starting with # are notes and are ignored.

# The password for sending changes. At least 24 characters.
# Leave it empty here and run ./hub token to create a random one.
HUB_TOKEN=

# The port the TV and hubctl talk to (the "main door").
HUB_PORT=8097

# Only these addresses may use the screen side (comma-separated), for example 192.168.1.x.
# Empty means any device on your home network.
HUB_TV_IPS=

# Web page origins allowed to talk to the server from a browser (TizenBrew uses this one).
HUB_ORIGINS=http://127.0.0.1:8081

# Optional side door for a tunnel, on 127.0.0.1 only: password-protected commands and nothing else.
# Empty means no side door. Not needed to start.
HUB_TUNNEL_PORT=

# Folder where state.json (your to-do list) is kept, relative to this folder.
HUB_DATA_DIR=./data

# Calendars: these are NOT used yet. They are here so you know where they will go.
# Each URL is a secret iCal link, so it belongs only in .env, never in git.
# CALENDAR_1_NAME=
# CALENDAR_1_URL=
# CALENDAR_2_NAME=
# CALENDAR_2_URL=
